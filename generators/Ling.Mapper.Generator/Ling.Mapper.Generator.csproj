<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <Description>Explicit-pair C# source generator for Ling.Mapper Native AOT mapping.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageReleaseNotes>1.3.2: Independent mutable graphs by default; MapFrom selects a source value for recursive mapping, while explicit final converters retain ownership. CurrentCulture scalar text conversion; existing-target mapping, member rules, projection/context and generator improvements. Upgrade both packages and recompile generated consumers. Behavioral migration required; Mapster performance parity, current NativeAOT execution and real SQL translation are not claimed. See CHANGELOG.md.</PackageReleaseNotes>
    <PackageId>Ling.Mapper.Generator</PackageId>
    <Version>1.3.2</Version>
    <Authors>yanhuuo</Authors>
    <RepositoryUrl>https://github.com/yanhuuo/Ling.Mapper</RepositoryUrl>
    <PackageProjectUrl>https://github.com/yanhuuo/Ling.Mapper</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>
</Project>
